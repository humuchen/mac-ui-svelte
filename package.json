{
  "name": "@humuchen/mac-ui-svelte",
  "version": "0.0.1",
  "type": "module",
  "description": "macOS 风格 Svelte 5 组件库（mac-ui 的 Svelte版）",
  "license": "MIT",
  "author": "huyang",
  "keywords": [
    "svelte",
    "component-library",
    "mac-ui",
    "mac-ui-svelte",
    "macos"
  ],
  "main": "./dist/lib/@humuchen/mac-ui-svelte.cjs.js",
  "module": "./dist/lib/@humuchen/mac-ui-svelte.esm.js",
  "unpkg": "./dist/@humuchen/mac-ui-svelte.umd.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/@humuchen/mac-ui-svelte.js",
      "require": "./dist/@humuchen/mac-ui-svelte.cjs.js"
    },
    "./styles/*": "./dist/lib/styles/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.build.json && vite build --config vite.lib.config.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert-theme": "node scripts/convert-theme.mjs",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.0.0",
    "jsdom": "^29.0.0",
    "storybook": "^8.6.14",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
